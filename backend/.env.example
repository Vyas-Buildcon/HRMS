# ===== Shared =====
NODE_ENV=development
APP_ENV=development            # set to "production" in prod (enforces strong JWT_SECRET, explicit CORS)
APP_URL="http://localhost:3000"   # frontend URL (used in e-mailed links)
PORT=5000

# Generate with: openssl rand -hex 32   (REQUIRED in production, min 32 chars)
JWT_SECRET="change-me"
JWT_ALGORITHM="HS256"
JWT_EXPIRE_MINUTES=1440

# ===== Database / CORS =====
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DB_NAME="zenith_hrms"
# Comma-separated browser origins allowed to call the API
CORS_ORIGINS="http://localhost:3000"

# ===== AI assistant =====
GEMINI_API_KEY=""

# ===== Mail (Resend & Brevo & SMTP) =====
RESEND_API_KEY="YOUR_RESEND_API_KEY_HERE"
BREVO_API_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_KEY=""
SMTP_SECURE="false"
MAIL_FROM="Mantria Projects <noreply@mantriaiprojects.com>"
COMPANY_NAME="Sahakar AI"

# ===== Attendance geofence (optional) =====
# JSON, see app/utils/geofence.py for the expected shape
OFFICE_COORDS=""
